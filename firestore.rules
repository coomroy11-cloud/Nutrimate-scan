rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny All by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile document: private to the authenticated owner
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isValidId(userId) && isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isValidId(userId) && isOwner(userId);

      // Private scan history subcollection: isolated per user
      match /scanHistory/{scanId} {
        allow list: if isValidId(userId) && isOwner(userId);
        allow get: if isValidId(userId) && isValidId(scanId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(scanId) && isOwner(userId) && request.resource.data.uid == request.auth.uid;
        allow update: if isValidId(userId) && isValidId(scanId) && isOwner(userId) && request.resource.data.uid == resource.data.uid;
        allow delete: if isValidId(userId) && isValidId(scanId) && isOwner(userId);
      }
    }
  }
}
